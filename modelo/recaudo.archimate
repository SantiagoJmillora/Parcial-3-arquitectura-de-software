      <documentation>Comando de Consolidación y conciliación (DOM07). Expresa la intención; si la raíz ProcesoConciliación acepta la operación sin violar sus invariantes, emite ConciliaciónEjecutada.</documentation>
      <property key="ID" value="CMD-DOM07"/>
    </element>
    <element xsi:type="archimate:ApplicationEvent" name="ConciliaciónEjecutada" id="id-3fe03fba769544848cc9c39faca820fc">
      <documentation>Evento de Consolidación y conciliación (DOM07): hecho ocurrido cuando el comando EjecutarConciliación es aceptado.</documentation>
      <property key="ID" value="EVT-DOM07"/>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="RegistrarResultadoConciliación" id="id-a82bf5ef335f4feb822435854aaacdcf">
